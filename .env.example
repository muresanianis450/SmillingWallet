# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# .env is gitignored — NEVER commit real secrets
# ─────────────────────────────────────────────────────────────────────────────

# Database
DB_USERNAME=postgres
DB_PASSWORD=your_strong_db_password_here

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_very_long_random_secret_at_least_256_bits

# TOTP 2FA encryption key — 32+ random chars
APP_TOTP_ENCRYPTION_KEY=change_me_to_a_random_key_32chars_min

# Email (Gmail SMTP App Password — not your Gmail password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_16chars

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
