# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ── Required secrets ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-256-bits

# Gmail App Password (generate at https://myaccount.google.com/apppasswords)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# TOTP encryption key (any strong random string)
APP_TOTP_ENCRYPTION_KEY=replace-with-random-key

# ── Optional overrides ────────────────────────────────────────────────────────
# Only needed if you change the DB credentials above
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/smilingwallet
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
