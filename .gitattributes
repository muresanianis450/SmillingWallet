# Normalise line endings so a Windows checkout matches what CI (Linux) sees.
# Without this, Spotless passes in CI but fails locally on every CRLF file.
* text=auto eol=lf

/mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.p12 binary
*.jks binary
*.xlsx binary
*.pdf binary
