HELP.md
target/

# Docker secrets — never commit real values
.env
!.env.example
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Frontend — keep node_modules and local .env out of git
src/frontend/node_modules/
src/frontend/.env
src/frontend/dist

# Backend secrets / local overrides
src/main/resources/keystore/
src/main/resources/application.yml
src/main/resources/application-local.yml
src/main/backend/resources/application.yml
src/backend/resources/application-local.yml

